# Copy to .env (never committed) and fill in. Only the keys for layers you run are needed.
# In a Claude Code cloud session, keys are injected by the network proxy instead:
# set the variable to any dummy value (for example "proxy") and save the real key
# as a network secret for the host listed next to it.

APIFY_TOKEN=            # Layer 1 + 3 people search (api.apify.com)
FULLENRICH_API_KEY=     # Layer 3 people search + work email (app.fullenrich.com)
LEADMAGIC_API_KEY=      # optional, not used by default (api.leadmagic.io)
MILLIONVERIFIER_API_KEY=  # Layer 4 (api.millionverifier.com)
OPENROUTER_API_KEY=     # TypeSafe Jev 1.14 only, via openrouter.ai/api/alpha/decisions (see clients/*/ai.yaml)
SMARTLEAD_API_KEY=      # Layer 6 (server.smartlead.ai), one account for all clients (kept apart by mailbox_domains)
HUBSPOT_TOKEN=          # Layer 7 (api.hubapi.com)
HUBSPOT_TOKEN_QUAILWORKS=  # Layer 7, Quailworks' own HubSpot portal (clients/quailworks/client.yaml)
