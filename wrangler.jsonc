// Cloudflare deploy config for quailworks.co
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quailworks-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "quailworks.co", "custom_domain": true },
    { "pattern": "www.quailworks.co", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
