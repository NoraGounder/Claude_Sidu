// Cloudflare deploy config for quailworks.co
// `wrangler deploy` runs scripts/build.mjs first, which packs ./site into the Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quailworks-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build.mjs" },
  "routes": [
    { "pattern": "quailworks.co", "custom_domain": true },
    { "pattern": "www.quailworks.co", "custom_domain": true }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "hello@quailworks.co",
      "allowed_sender_addresses": ["website@quailworks.co"]
    }
  ],
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
